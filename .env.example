# Copy this file to ".env" and fill in the values. Never commit ".env" or share it.

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# Long random string that signs the login cookie.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=KHPqAWcJ3cSBwG8hnwhwNpSfIdOC3oeWAlQ2mDipUIyI9CYW_iJYJCT4O-6xDcdg

# Set to 1 when the site runs on https (it should, for any real deployment)
SESSION_HTTPS_ONLY=1

# Set to 1 only if the app runs behind a proxy you control (Nginx, Render, Railway...)
# so the real student IP is used for rate limits.
TRUST_PROXY=1

